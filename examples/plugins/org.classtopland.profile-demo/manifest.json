{
  "manifestVersion": 2,
  "apiVersion": 2,
  "id": "org.classtopland.profile-demo",
  "name": "插件示例：档案写入",
  "version": "2.0.0",
  "entry": "main.mjs",
  "description": "原生功能页与 Agent 共享档案写入动作；建议在测试档案体验。",
  "permissions": {
    "profiles": "write-current"
  },
  "contributions": {
    "pages": [
      {
        "id": "profile",
        "name": "档案写入",
        "purpose": "function",
        "ui": "profile.ui"
      }
    ],
    "actions": [
      {
        "id": "addSubject",
        "name": "添加示例科目",
        "description": "立即向当前档案添加指定名称的科目并保存。",
        "requiredPermissions": [
          "profiles"
        ],
        "inputSchema": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "maxLength": 100
            }
          },
          "required": [
            "name"
          ],
          "additionalProperties": false
        },
        "outputSchema": {
          "type": "object",
          "properties": {
            "revision": {
              "type": "string"
            }
          },
          "required": [
            "revision"
          ]
        }
      }
    ]
  }
}
