{
  "manifestVersion": 2,
  "apiVersion": 2,
  "id": "org.classtopland.example-tools",
  "name": "插件示例：课程助手",
  "version": "2.0.0",
  "entry": "main.mjs",
  "description": "原生多页设置、课程表格、动态控件、课程条组件与 Agent 动作。",
  "permissions": {
    "courses": "read"
  },
  "contributions": {
    "pages": [
      {
        "id": "details",
        "name": "课程详情",
        "purpose": "function",
        "ui": "details.ui"
      },
      {
        "id": "general",
        "name": "常规设置",
        "purpose": "settings",
        "ui": "general.ui"
      },
      {
        "id": "display",
        "name": "显示设置",
        "purpose": "settings",
        "ui": "display.ui"
      }
    ],
    "courseBarComponents": [
      {
        "id": "status",
        "name": "课程状态",
        "ui": "component.ui",
        "settingsUi": "component-settings.ui",
        "previewText": "课程状态",
        "displayPolicy": "whenAvailable"
      }
    ],
    "actions": [
      {
        "id": "summary",
        "name": "获取课程摘要",
        "description": "读取当前课程状态并返回摘要。",
        "requiredPermissions": [
          "courses"
        ],
        "inputSchema": {
          "type": "object",
          "properties": {},
          "required": [],
          "additionalProperties": false
        },
        "outputSchema": {
          "type": "object",
          "properties": {
            "text": {
              "type": "string"
            }
          },
          "required": [
            "text"
          ]
        }
      }
    ]
  }
}
